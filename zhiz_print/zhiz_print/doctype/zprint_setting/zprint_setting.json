  "fields": [
    {
      "default": "0",
      "description": "When enabled, the print page displays a custom print template selector on the left. Create print templates in Super Print Design first",
      "fieldname": "enable_super_print_page",
      "fieldtype": "Check",
      "label": "Enable Super Print Page"
    },
    {
      "depends_on": "eval:doc.enable_super_print_page",
      "fieldname": "section_break_print_mode",
      "fieldtype": "Section Break"
    },
    {
      "default": "Enable for All",
      "depends_on": "eval:doc.enable_super_print_page",
      "description": "Enable for All: all DocTypes use Super Print; Enable for Specific: only DocTypes listed below use Super Print",
      "fieldname": "print_enable_mode",
      "fieldtype": "Select",
      "label": "Enable Mode",
      "options": "Enable for All\nEnable for Specific"
    },
    {
      "fieldname": "column_break_print_engine",
      "fieldtype": "Column Break"
    },
    {
      "default": "wkhtmltopdf",
      "depends_on": "eval:doc.enable_super_print_page",
      "description": "Select the conversion engine for PDF export",
      "fieldname": "pdf_engine_mode",
      "fieldtype": "Select",
      "label": "PDF Engine Mode",
      "options": "WeasyPrint\nwkhtmltopdf\nChromium"
    },
    {
      "depends_on": "eval:doc.enable_super_print_page && doc.print_enable_mode==='Enable for Specific'",
      "fieldname": "section_break_print_doctypes",
      "fieldtype": "Section Break",
      "label": "Enabled DocTypes"
    },
    {
      "depends_on": "eval:doc.enable_super_print_page && doc.print_enable_mode==='Enable for Specific'",
      "description": "Add DocTypes for Super Print. Only these DocTypes will use the Super Print page",
      "fieldname": "print_enabled_doctypes",
      "fieldtype": "Table",
      "label": "Enabled DocTypes",
      "options": "Super Print Enabled Doctype"
    },
    {
      "depends_on": "eval:doc.enable_super_print_page",
      "fieldname": "section_break_export",
      "fieldtype": "Section Break",
      "label": "Export Settings"
    },
    {
      "default": "1",
      "depends_on": "eval:doc.enable_super_print_page",
      "fieldname": "allow_export_pdf",
      "fieldtype": "Check",
      "label": "Allow Export PDF"
    },
    {
      "fieldname": "column_break_export",
      "fieldtype": "Column Break"
    },
    {
      "default": "1",
      "depends_on": "eval:doc.enable_super_print_page",
      "fieldname": "allow_export_excel",
      "fieldtype": "Check",
      "label": "Allow Export Excel"
    },
    {
      "fieldname": "section_break_license",
      "fieldtype": "Section Break",
      "label": "Subscription"
    },
    {
      "fieldname": "license_info",
      "fieldtype": "HTML",
      "label": "License Info",
      "options": "<div id=\"license-info-container\"></div>"
    },
    {
      "fieldname": "license_key_input",
      "fieldtype": "Data",
      "label": "Current License",
      "read_only": 1
    }
  ],
