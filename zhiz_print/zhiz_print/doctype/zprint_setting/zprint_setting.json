 ],
 "fields": [
  {
   "fieldname": "section_break_doc_print",
   "fieldtype": "Section Break",
   "label": "Document Print"
  },
  {
   "default": "0",
   "description": "When enabled, the print page displays a custom print template selector on the left. Create print templates in Super Print Design first",
   "fieldname": "enable_super_print_page",
   "fieldtype": "Check",
   "label": "Enable Document Print"
  },
  {
   "fieldname": "column_break_doc",
   "fieldtype": "Column Break"
  },
  {
   "default": "Enable for All",
   "depends_on": "eval:doc.enable_super_print_page",
   "description": "Enable for All: all DocTypes use Super Print; Enable for Specific: only DocTypes listed below use Super Print",
   "fieldname": "print_enable_mode",
   "fieldtype": "Select",
   "label": "Document Enable Mode",
   "options": "Enable for All\nEnable for Specific"
  },
  {
   "depends_on": "eval:doc.enable_super_print_page && doc.print_enable_mode==='Enable for Specific'",
   "description": "Add DocTypes for Super Print. Only these DocTypes will use the Super Print page",
   "fieldname": "print_enabled_doctypes",
   "fieldtype": "Table",
   "label": "Enabled DocTypes",
   "options": "Super Print Enabled Doctype"
  },
  {
   "fieldname": "section_break_report",
   "fieldtype": "Section Break",
   "label": "Report Print"
  },
  {
   "fieldname": "report_print_enabled",
   "fieldtype": "Check",
   "label": "Enable Report Print"
  },
  {
   "fieldname": "column_break_report",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "report_enable_mode",
   "fieldtype": "Select",
   "label": "Report Enable Mode",
   "options": "Enable for All\nEnable for Specific",
   "depends_on": "eval:doc.report_print_enabled",
   "default": "Enable for All"
  },
  {
   "fieldname": "report_enabled_reports",
   "fieldtype": "Table",
   "label": "Report Enabled Reports",
   "options": "Super Print Enabled Report",
   "depends_on": "eval:doc.report_print_enabled && doc.report_enable_mode === 'Enable for Specific'"
  },
  {
   "fieldname": "section_break_engine",
   "fieldtype": "Section Break",
   "label": "Print Engine"
  },
  {
   "default": "wkhtmltopdf",
   "description": "Select the conversion engine for PDF export",
   "fieldname": "pdf_engine_mode",
   "fieldtype": "Select",
   "label": "PDF Engine Mode",
   "options": "WeasyPrint\nwkhtmltopdf\nChromium"
  },
  {
   "depends_on": "eval:doc.enable_super_print_page",
   "fieldname": "section_break_image_render",
   "fieldtype": "Section Break",
   "label": "Image Rendering"
  },
  {
   "default": "0",
   "depends_on": "eval:doc.enable_super_print_page",
   "description": "When enabled, images are embedded as base64 data URIs for self-contained PDF output. Otherwise referenced by URL.",
   "fieldname": "explicit_image_preview",
   "fieldtype": "Check",
   "label": "Use Explicit Image Rendering"
  },
  {
   "depends_on": "eval:doc.enable_super_print_page",
   "fieldname": "section_break_export",
   "fieldtype": "Section Break",
   "label": "Export Settings"
  },
  {
   "default": "1",
   "depends_on": "eval:doc.enable_super_print_page",
   "fieldname": "allow_export_pdf",
   "fieldtype": "Check",
   "label": "Allow Export PDF"
  },
  {
   "fieldname": "column_break_export",
   "fieldtype": "Column Break"
  },
  {
   "default": "1",
   "depends_on": "eval:doc.enable_super_print_page",
   "fieldname": "allow_export_excel",
   "fieldtype": "Check",
   "label": "Allow Export Excel"
  },
  {
   "depends_on": "eval:doc.enable_super_print_page",
   "fieldname": "section_break_native",
   "fieldtype": "Section Break",
   "label": "Native Print Formats"
  },
  {
   "default": "0",
   "depends_on": "eval:doc.enable_super_print_page",
   "description": "Show a collapsible \"Native Print Formats\" section in the print preview sidebar. Users can preview/print with frappe built-in Print Formats (e.g. Standard); native prints are recorded in print history too.",
   "fieldname": "enable_native_print_formats",
   "fieldtype": "Check",
   "label": "Enable Supported Native Print Formats"
  },
  {
   "collapsible": 1,
   "fieldname": "section_break_scan_print",
   "fieldtype": "Section Break",
   "label": "Scan Print"
  },
  {
   "default": "0",
   "description": "Master switch for scan-to-print (silent printing). Paid feature: only paid (non-STD) activation keys are allowed",
   "fieldname": "scan_print_enabled",
   "fieldtype": "Check",
   "label": "Enable Scan Print"
  },
  {
   "default": "1",
   "description": "Channel A: print agent (ZhizPrintAgent) on a shop-floor Windows PC",
   "fieldname": "channel_a_enabled",
   "fieldtype": "Check",
   "label": "Enable Channel A"
  },
  {
   "default": "0",
   "description": "Channel B: direct IPP to LAN printers. Keep off for cloud deployments",
   "fieldname": "channel_b_enabled",
   "fieldtype": "Check",
   "label": "Enable Channel B"
  },
  {
   "default": "0",
   "description": "Channel C: cloud printer/box (Liankenet, Xpyun)",
   "fieldname": "channel_c_enabled",
   "fieldtype": "Check",
   "label": "Enable Channel C"
  },
  {
   "default": "0",
   "description": "Long polling on scan endpoints. Keep off by default (gunicorn sync workers are scarce)",
   "fieldname": "long_poll_enabled",
   "fieldtype": "Check",
   "label": "Enable Long Polling"
  },
  {
   "default": "Cloud",
   "description": "Semaphore sizing basis for concurrent scan renders: Cloud=2 slots, LAN=4 slots",
   "fieldname": "scan_semaphore_mode",
   "fieldtype": "Select",
   "label": "Scan Semaphore Mode",
   "options": "Cloud\nLAN"
  },
  {
   "fieldname": "column_break_scan_1",
   "fieldtype": "Column Break"
  },
  {
   "default": "3",
   "fieldname": "poll_interval_sec",
   "fieldtype": "Int",
   "label": "Poll Interval (sec)"
  },
  {
   "default": "60",
   "description": "Same scan code + station within this window merges into one print job",
   "fieldname": "dedup_window_sec",
   "fieldtype": "Int",
   "label": "Dedup Window (sec)"
  },
  {
   "default": "2",
   "fieldname": "max_retry",
   "fieldtype": "Int",
   "label": "Max Retry"
  },
  {
   "default": "30",
   "fieldname": "job_retain_days",
   "fieldtype": "Int",
   "label": "Job Retain Days"
  },
  {
   "description": "Lowest accepted print agent version; older agents are flagged in the agent dashboard",
   "fieldname": "min_agent_version",
   "fieldtype": "Data",
   "label": "Min Agent Version"
  },
  {
   "fieldname": "column_break_scan_2",
   "fieldtype": "Column Break"
  },
  {
   "default": "2097152",
   "description": "PDF up to this size is stored inline in the job row, larger goes to private files",
   "fieldname": "pdf_inline_threshold_bytes",
   "fieldtype": "Int",
   "label": "PDF Inline Threshold (bytes)"
  },
  {
   "default": "30",
   "description": "Seconds allowed for one PDF render (Chromium subprocess timeout)",
   "fieldname": "scan_render_budget_s",
   "fieldtype": "Int",
   "label": "Scan Render Budget (sec)"
  },
  {
   "default": "4",
   "fieldname": "scan_max_concurrent",
   "fieldtype": "Int",
   "label": "Scan Max Concurrent"
  },
  {
   "default": "3145728",
   "description": "Hard cap on template asset size (images etc.) for scan rendering",
   "fieldname": "template_asset_budget_bytes",
   "fieldtype": "Int",
   "label": "Template Asset Budget (bytes)"
  },
  {
   "description": "Absolute path or command name of the Chromium executable, overrides auto-detection when valid",
   "fieldname": "chromium_path",
   "fieldtype": "Data",
   "label": "Chromium Path"
  },
  {
   "default": "600",
   "description": "Seconds before an unconfirmed Channel C vendor job turns unknown",
   "fieldname": "vendor_confirm_timeout_sec",
   "fieldtype": "Int",
   "label": "Vendor Confirm Timeout (sec)"
  },
  {
   "default": "0",
   "description": "Channel C: clear the Liankenet errLimitNum failure lock automatically",
   "fieldname": "auto_reset_vendor_err_limit",
   "fieldtype": "Check",
   "label": "Auto Reset Vendor Error Limit"
  },
  {
   "fieldname": "section_break_license",
   "fieldtype": "Section Break",
   "label": "Subscription"
  },
  {
   "fieldname": "license_info",
   "fieldtype": "HTML",
   "label": "License Info",
   "options": "<div id=\"license-info-container\"></div>"
  },
  {
   "fieldname": "license_key_input",
   "fieldtype": "Data",
   "label": "Current License",
   "read_only": 1
  },
  {
   "fieldname": "contact_info",
   "fieldtype": "HTML",
   "label": "Contact Info",
   "options": "<div id=\"contact-info-container\"></div>"
  }
 ],
